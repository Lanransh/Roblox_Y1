{
  "name": "Roblox_Y1",
  "emitLegacyScripts": true,
  "serveAddress": "127.0.0.1",
  "globIgnorePaths": ["**/.gitkeep"],
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Scripts": {
        "$path": "ReplicatedStorage/Scripts",
        "$ignoreUnknownInstances": false
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "Server": {
        "$path": "ServerScriptService/Server",
        "$ignoreUnknownInstances": false
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "$ignoreUnknownInstances": true
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$ignoreUnknownInstances": true,
      "ScreenGui": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "$properties": {
          "Enabled": true,
          "DisplayOrder": 1,
          "ResetOnSpawn": false,
          "ScreenInsets": "CoreUISafeInsets",
          "ClipToDeviceSafeArea": true,
          "SafeAreaCompatibility": "None",
          "ZIndexBehavior": "Sibling"
        },
        "CanvasAdapter": {
          "$path": "StarterGui/ScreenGui/CanvasAdapter.client.lua"
        }
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "Client": {
          "$path": "StarterPlayer/StarterPlayerScripts/Client",
          "$ignoreUnknownInstances": false
        }
      }
    }
  }
}
