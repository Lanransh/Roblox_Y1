{
  "name": "Roblox_Y1",
  "emitLegacyScripts": true,
  "serveAddress": "127.0.0.1",
  "globIgnorePaths": ["**/.gitkeep"],
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "Lighting": {
      "$className": "Lighting",
      "$ignoreUnknownInstances": true,
      "Obby Sky": {
        "$className": "Sky",
        "$properties": {
          "SkyboxBk": "rbxassetid://16573631102",
          "SkyboxDn": "rbxassetid://16573631950",
          "SkyboxFt": "rbxassetid://16573632795",
          "SkyboxLf": "rbxassetid://16573633258",
          "SkyboxRt": "rbxassetid://16573633908",
          "SkyboxUp": "rbxassetid://16573634370",
          "CelestialBodiesShown": true,
          "SunTextureId": "rbxasset://sky/sun.jpg",
          "MoonTextureId": "rbxasset://sky/moon.jpg",
          "SunAngularSize": 21,
          "MoonAngularSize": 11,
          "StarCount": 3000
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true,
      "BlockMeshs": {
        "$className": "Folder",
        "$path": "Workspace/BlockMeshs"
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Scripts": {
        "$path": "ReplicatedStorage/Scripts",
        "$ignoreUnknownInstances": false
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "Server": {
        "$path": "ServerScriptService/Server",
        "$ignoreUnknownInstances": false
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "$ignoreUnknownInstances": true
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$ignoreUnknownInstances": true,
      "ScreenGui": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "$properties": {
          "Enabled": true,
          "DisplayOrder": 1,
          "ResetOnSpawn": false,
          "ScreenInsets": "CoreUISafeInsets",
          "ClipToDeviceSafeArea": true,
          "SafeAreaCompatibility": "None",
          "ZIndexBehavior": "Sibling"
        },
        "CanvasAdapter": {
          "$path": "StarterGui/ScreenGui/CanvasAdapter.client.lua"
        }
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "Client": {
          "$path": "StarterPlayer/StarterPlayerScripts/Client",
          "$ignoreUnknownInstances": false
        }
      }
    }
  }
}
