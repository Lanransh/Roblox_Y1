      "name": "FigmaCanvasAdapter",
      "className": "LocalScript",
      "properties": {
        "Source": "local screen = script.Parent\nlocal canvas = screen:FindFirstChildWhichIsA(\"GuiObject\")\nwhile not canvas do\n    screen.ChildAdded:Wait()\n    canvas = screen:FindFirstChildWhichIsA(\"GuiObject\")\nend\nlocal scale = canvas:WaitForChild(\"FigmaScale\")\nlocal width = tonumber(script:GetAttribute(\"DesignWidth\"))\nlocal height = tonumber(script:GetAttribute(\"DesignHeight\"))\nlocal offsetX = tonumber(script:GetAttribute(\"DesignOffsetX\"))\nlocal offsetY = tonumber(script:GetAttribute(\"DesignOffsetY\"))\nlocal function resize()\n    local size = screen.AbsoluteSize\n    local ratio = math.min(size.X / width, size.Y / height)\n    scale.Scale = ratio\n    canvas.Position = UDim2.new(0.5, offsetX * ratio, 0.5, offsetY * ratio)\nend\nscreen:GetPropertyChangedSignal(\"AbsoluteSize\"):Connect(resize)\nresize()\n"
      },
